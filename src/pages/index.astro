---
import Base from '../layouts/Base.astro';
import PriceChecked from '../components/PriceChecked.astro';
import { getData } from '../lib/data';
import { bracketSlug } from '../lib/brackets';
import { latestCheck } from '../lib/format';
import { landingPaths, phonesInBracket } from '../lib/landing';
import { withBase } from '../lib/paths';

const data = getData();
const brackets = landingPaths(data).map((p) => p.props.ceiling);
const checked = latestCheck(data.phones);
---
<Base
  title="MobileUnder.pk: best mobile phones by budget in Pakistan"
  description="Pick a budget and compare phones actually available in Pakistan, with PTA status, warranty and checked PKR prices."
  path="/"
>
  <h1>Best mobile phones in Pakistan by budget</h1>
  <p>Phones released in 2024, 2025 and 2026, up to 150,000 PKR, with PTA status, warranty and checked prices.</p>
  {checked && <PriceChecked date={checked} />}
  {brackets.length > 0 && <p><a href={withBase('/finder/')}>Help me decide: filter and rank every phone</a></p>}
  {brackets.length > 0 ? (
    <ul class="bracket-chips">
      {brackets.map((c) => (
        <li><a href={withBase(`/${bracketSlug(c)}/`)}>Under {c.toLocaleString('en-US')}</a> ({phonesInBracket(data, c).length} phones)</li>
      ))}
    </ul>
  ) : (
    <p>Phone data is being researched. Check back soon.</p>
  )}
</Base>
