---
import Base from '../layouts/Base.astro';
import PhoneTable from '../components/PhoneTable.astro';
import PriceChecked from '../components/PriceChecked.astro';
import { getData } from '../lib/data';
import { latestCheck } from '../lib/format';
import { rankPhones } from '../lib/scoring';
import { breadcrumbLd } from '../lib/seo';
import { withBase } from '../lib/paths';
import { SCORE_NAMES } from '../lib/compare';
import { RELEASE_YEARS, SCORE_KEYS } from '../schema/phone';

const data = getData();
const balanced = data.presets.find((p) => p.slug === 'balanced')!;
const ranked = rankPhones(data.phones, balanced);
const brands = data.brands.filter((b) => data.phones.some((p) => p.brand === b.slug));
const years = RELEASE_YEARS.filter((y) => data.phones.some((p) => p.releaseDate.startsWith(String(y))));
const checked = latestCheck(data.phones);
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const presets = [50000, 100000, 150000];
---
<Base
  title="Phone finder: filter and rank phones in Pakistan by budget"
  description="Filter phones sold in Pakistan by price, brand, PTA status, warranty, 5G and battery, then rank them by what matters to you. Share the result as a link."
  path="/finder/"
  jsonLd={[breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Finder', path: '/finder/' }], Astro.site!)]}
>
  <nav aria-label="Breadcrumb"><a href={withBase('/')}>Home</a> / Finder</nav>
  <h1>Find your phone</h1>
  {checked && <PriceChecked date={checked} />}

  <form id="finder" class="finder-layout" method="get">
    <aside class="finder-filters" id="finder-filters" aria-label="Filters">
        <div class="finder-filters-head">
          <h2>Filters</h2>
          <button type="button" class="drawer-close" aria-label="Close filters">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>

        <fieldset>
          <legend>Budget (PKR)</legend>
          <div class="budget-row">
            <label>From <input name="min" type="number" inputmode="numeric" min="0" step="500" placeholder="0" /></label>
            <label>To <input name="max" type="number" inputmode="numeric" min="0" step="500" placeholder="Any" /></label>
          </div>
          <p class="budget-presets">{presets.map((m) => <a href={`?max=${m}`}>Under {m / 1000}k</a>)}</p>
        </fieldset>

        <fieldset>
          <legend>Brand</legend>
          <div class="chips">{brands.map((b) => <label class="chip"><input type="checkbox" name="brand" value={b.slug} /><span>{b.name}</span></label>)}</div>
        </fieldset>

        <fieldset>
          <legend>Released</legend>
          <div class="chips">{years.map((y) => <label class="chip"><input type="checkbox" name="year" value={y} /><span>{y}</span></label>)}</div>
        </fieldset>

        <fieldset>
          <legend>Must have</legend>
          <div class="chips">
            <label class="chip"><input type="checkbox" name="pta" value="1" /><span>PTA price only</span></label>
            <label class="chip"><input type="checkbox" name="official" value="1" /><span>Official warranty</span></label>
            <label class="chip"><input type="checkbox" name="5g" value="1" /><span>5G</span></label>
            <label class="chip"><input type="checkbox" name="nfc" value="1" /><span>NFC</span></label>
            <label class="chip"><input type="checkbox" name="jack" value="1" /><span>Headphone jack</span></label>
            <label class="chip"><input type="checkbox" name="status" value="available" /><span>In stock widely</span></label>
          </div>
          <div class="select-row">
            <label>Battery <select name="battery"><option value="">Any</option><option value="5000">5000 mAh+</option><option value="5500">5500 mAh+</option><option value="6000">6000 mAh+</option><option value="7000">7000 mAh+</option></select></label>
            <label>Screen <select name="hz"><option value="">Any</option><option value="90">90Hz+</option><option value="120">120Hz+</option></select></label>
          </div>
        </fieldset>

        <details class="weights">
          <summary>Custom weights</summary>
          <p>Leave blank to use the priority. 0 ignores a score, 3 counts it triple.</p>
          {SCORE_KEYS.map((k) => <label>{cap(SCORE_NAMES[k])} <input name={`w-${k}`} type="number" min="0" max="3" step="0.25" /></label>)}
        </details>
        <button type="button" class="drawer-apply">Show phones</button>
    </aside>
    <div class="drawer-backdrop"></div>

    <div class="finder-results">
      <div class="finder-sortbar">
        <button type="button" class="filters-toggle" aria-controls="finder-filters" aria-expanded="false">Filters</button>
        <label>Priority <select name="preset">{data.presets.map((p) => <option value={p.slug}>{p.name}</option>)}</select></label>
        <label>Sort by <select name="sort">
          <option value="overall">Overall score</option>
          <option value="price">Price, low to high</option>
          <option value="release">Newest first</option>
          {SCORE_KEYS.map((k) => <option value={k}>{cap(SCORE_NAMES[k])}</option>)}
        </select></label>
      </div>
      <p id="finder-count" aria-live="polite">Showing all {ranked.length} phones</p>
      <p id="finder-notice" class="notice" hidden></p>
      <PhoneTable rows={ranked} brands={data.brands} />
    </div>
  </form>

  <script type="application/json" id="finder-presets" set:html={JSON.stringify(data.presets).replace(/</g, '\\u003c')} />
  <script src="../scripts/finder.ts"></script>
</Base>
